# Google Gemini API Configuration for NPC Generative AI Brain
# Get a free Gemini API key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Local AI Model Manager (9Router) Configuration
# 9Router exposes an OpenAI-compatible endpoint for local LLMs (e.g., Llama 3, Qwen, Mistral)
VITE_9ROUTER_URL=http://localhost:20128/v1
VITE_9ROUTER_API_KEY=
VITE_9ROUTER_PASSWORD=
VITE_9ROUTER_MODEL=default
